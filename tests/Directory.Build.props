<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- xUnit1051: CancellationToken usage — not relevant for resilience library tests
         where we deliberately control cancellation tokens
         CS0162: Unreachable code — expected after assertions that always throw
         CS0219: Variable assigned but never used — test helper variables -->
    <NoWarn>$(NoWarn);xUnit1051;CS0162;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    <!-- Shared by all three test projects. Kept here rather than per-project because it had
         drifted to two different versions, which meant the fake clock under test was not the
         same one everywhere. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
  </ItemGroup>

  <!--
    Why the test projects reference Microsoft.Extensions.* 9.0.0 while src targets the 8.0.x line:
    that is deliberate, not drift. The shipped packages declare 8.0.x, so without an explicit
    reference the tests would resolve 8.0.0 transitively and only ever exercise the library
    against the versions it declares. Pinning 9.0.0 in the test projects runs the same assemblies
    against a newer DI container, HttpClientFactory and options stack, which is what a consumer on
    a current runtime actually has.

    A dependency audit will report these as redundant, because the code compiles without them.
    Removing one silently downgrades what is under test. Verified 2026-10-23: dropping the two
    explicit references from Resilion.Http.Tests resolved Microsoft.Extensions.Http and
    .DependencyInjection back to 8.0.0.
  -->

</Project>
