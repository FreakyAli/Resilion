<Project>

  <PropertyGroup>
    <!-- VersionPrefix, not Version: setting Version explicitly suppresses VersionSuffix handling,
         so `-p:VersionSuffix=pre` would be silently ignored. The release workflow overrides both
         with -p:Version from the git tag. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>FreakyAli</Authors>
    <Copyright>Copyright 2026</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/FreakyAli/Resilion</RepositoryUrl>
    <PackageProjectUrl>https://github.com/FreakyAli/Resilion</PackageProjectUrl>
    <PackageTags>resilience;retry;circuit-breaker;timeout;fallback;hedging;rate-limiting;fault-tolerance</PackageTags>
    <PackageReleaseNotes>See https://github.com/FreakyAli/Resilion/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- SourceLink is in-box in the .NET SDK (>= 8.0.100); no Microsoft.SourceLink.* package
         reference is needed or wanted. ContinuousIntegrationBuild is deliberately NOT set here:
         it normalizes the source paths embedded in the PDB, which breaks local debugging. CI
         passes it per-build, and it must be set at COMPILE time — setting it only on
         a `dotnet pack` that skips the build does nothing, because the PDB is already written. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <!-- Public API gate. Locally these stay warnings so an in-progress API doesn't block the
       inner loop; CI passes -p:ContinuousIntegrationBuild=true, which promotes them to errors.
         RS0016 = public symbol missing from PublicAPI.*.txt (accidental API addition)
         RS0017 = PublicAPI.*.txt declares a symbol that no longer exists (breaking removal)
       Scoped deliberately: TreatWarningsAsErrors would promote every unrelated CS/IL/NU warning
       too, which is how this kind of gate gets reverted. RS0026/RS0027 (optional-parameter
       overload design) stay advisory — they carry no compatibility guarantee.
       Reproduce CI locally:
         dotnet build Resilion.sln -c Release -p:ContinuousIntegrationBuild=true -->
  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>

  <!-- Public API Analysis -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
